{
  "version": 1,
  "sdk_version": "3.1.1",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://sojvuoldhneveiyzyptx.supabase.co/auth/v1",
    "require_oauth_client_claim": true,
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "el-arc-ngel-online",
      "version": "0.1.0",
      "title": "El Arcángel Online"
    },
    "tools": [
      {
        "name": "list_categories",
        "title": "Consultar categorías y marcas",
        "description": "Lista las categorías y subcategorías del catálogo de El Arcángel con sus identificadores.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "search_products",
        "title": "Buscar productos",
        "description": "Busca productos activos de El Arcángel por nombre, categoría o marca y devuelve precios en pesos argentinos y stock.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "query": {
              "description": "Parte del nombre del producto.",
              "type": "string",
              "maxLength": 120
            },
            "category_id": {
              "description": "Identificador de categoría obtenido de list_categories.",
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "subcategory_id": {
              "description": "Identificador de subcategoría o marca obtenido de list_categories.",
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "limit": {
              "default": 20,
              "description": "Cantidad máxima de resultados, entre 1 y 50.",
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            },
            "offset": {
              "default": 0,
              "description": "Cantidad de resultados a omitir para consultar la siguiente página.",
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            }
          },
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "get_product",
        "title": "Consultar un producto",
        "description": "Devuelve la descripción, imágenes, precio en ARS y stock de un producto activo del catálogo.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "product_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "Identificador del producto obtenido de search_products."
            }
          },
          "required": [
            "product_id"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      }
    ]
  }
}
